-- TABLE FOR FULL PLACE INFORMATION
-- ================================
CREATE TABLE IF NOT EXISTS place_details (
    place_id INTEGER PRIMARY KEY,
    history TEXT,
    description TEXT,
    interesting_facts TEXT,
    year_established INTEGER,
    importance TEXT,
    FOREIGN KEY(place_id) REFERENCES places(id)
);


UPDATE place_details
SET
    history = 'Lalbagh Botanical Garden was commissioned by Hyder Ali in 1760 and expanded by Tipu Sultan.',
    description = 'One of the largest botanical gardens in India, famous for its glass house.',
    interesting_facts = 'Hosts biannual flower shows and has rock formations over 3 billion years old.',
    year_established = 1760,
    importance = 'Major tourist attraction and botanical research center'
WHERE place_id = 1;


UPDATE place_details  
  2,
